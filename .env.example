# StarLearner-Nexus Configuration

# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=your_github_token_here

# GitHub Username (optional - defaults to authenticated user)
GITHUB_USERNAME=your_github_username

# Output directories (optional)
OUTPUT_DIR=./output
REPORTS_DIR=./reports
SKILLS_DIR=./skills

# Cron job settings
CRON_SCHEDULE="0 9 * * *"  # Daily at 9 AM
CRON_LOG_FILE=./cron.log

# Marketplace settings (future use)
MARKETPLACE_API_KEY=""
MARKETPLACE_URL=""